TARGET_COMPOSE_PROJECT=opentelemetry-demo
TARGET_REPOSITORY_PATH=../../opentelemetry-demo

STORE_URL=http://localhost:8080
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:8080/jaeger/ui

LLM_API_KEY=your-api-key-here

MAX_FAULT_DURATION_SECONDS=60
RECOVERY_TIMEOUT_SECONDS=180
RECOVERY_REQUIRED_SAMPLES=2
MAX_NETWORK_DELAY_MS=1000
MAX_PACKET_LOSS_PERCENT=40

LOCUST_URL=http://localhost:8080/loadgen
LOCUST_REQUEST_TIMEOUT_SECONDS=3
LOCUST_STATE_TIMEOUT_SECONDS=20
TRAFFIC_SPIKE_MAX_BASELINE_USERS=20
TRAFFIC_SPIKE_MAX_USERS=10
TRAFFIC_SPIKE_MAX_SPAWN_RATE=2
TRAFFIC_SPIKE_MAX_DURATION_SECONDS=30
